# Server-only Gemini key. Never prefix this with VITE_ or commit the real value.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Backend runtime (Render assigns PORT automatically).
PORT=3000
NODE_ENV=development
CORS_ORIGIN="http://localhost:3000,https://0cuong.github.io"

# Frontend build settings. Leave API URL empty for local same-origin dev.
VITE_API_BASE_URL=""
VITE_BASE_PATH="/"
