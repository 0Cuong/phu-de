# Server-only Gemini key. Never prefix this with VITE_ or commit the real value.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Backend runtime (Render assigns PORT automatically).
PORT=3000
NODE_ENV=development
CORS_ORIGIN="http://localhost:3000,https://0cuong.github.io"

# LOCAL development only: leave the API URL empty so requests use the local Express server.
# Production GitHub Pages builds receive VITE_API_BASE_URL from GitHub Actions Variables
# or from the api_base_url input in the Pages deployment workflow.
VITE_API_BASE_URL=""

# LOCAL development uses /. The GitHub Pages workflow overrides this to /phu-de/.
VITE_BASE_PATH="/"
